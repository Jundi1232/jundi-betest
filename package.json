{
  "name": "express-ts-basecode",
  "version": "1.0.0",
  "description": "Clean Architecture basecode for Node.js + Express + TypeScript",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint --ignore-path .eslintignore --ext .js,.ts .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "build": "npx tsc",
    "start": "node dist/src/index.js",
    "dev:http": "cross-env INTERFACE=HTTP concurrently \"npx tsc --watch\" \"nodemon -q dist/src/index.js\"",
    "dev:cron": "cross-env INTERFACE=CRON concurrently \"npx tsc --watch\" \"nodemon -q dist/src/index.js\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "http-errors": "^2.0.0",
    "ioredis": "^5.3.2",
    "mongoose": "^7.5.3",
    "node-cron": "^3.0.3",
    "reflect-metadata": "^0.1.13",
    "request-ip": "^3.3.0",
    "ts-mixer": "^6.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/http-errors": "^2.0.1",
    "@types/node": "^20.4.2",
    "@types/node-cron": "^3.0.11",
    "@types/request-ip": "^0.0.38",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.1.6"
  }
}
