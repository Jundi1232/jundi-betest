# GENERAL
NODE_ENV=local
BASE_PATH=
CORS=http://localhost:3000

# PORT
HTTP_PORT=3000
CRON_PORT=3001

# MONGODB
MONGODB_URI=mongodb://localhost:27017/db_jundi_betest

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_PREFIX=redis_jundi_betest:

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h

# CACHE
CACHE_TTL_SECONDS=300

# KAFKA (optional, set KAFKA_ENABLED=true to publish user events)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ms-jundi-betest
KAFKA_USER_TOPIC=kafka_jundi_betest
